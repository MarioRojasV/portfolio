---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#certifications', label: 'Certifications' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-semibold tracking-tight text-slate-100">Mario Rojas</a>
    <ul class="hidden gap-6 text-sm text-slate-400 sm:flex">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-cyan-400">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
